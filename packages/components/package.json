{
    "name": "@jig-ui/react",
    "version": "0.2.0",
    "description": "Jig design system — React components",
    "license": "MIT",
    "author": "Nate Bridi",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/natebridi/jig.git",
        "directory": "packages/components"
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./tokens": {
            "types": "./dist/tokens.d.ts",
            "default": "./dist/tokens.js"
        },
        "./icons": {
            "types": "./dist/icons.d.ts",
            "default": "./dist/icons.js"
        },
        "./styles.css": "./dist/styles.css",
        "./reset.css": "./dist/reset.css",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "vite build",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "generate:icons": "node scripts/generate-icons.mjs",
        "check:icons": "node scripts/generate-icons.mjs && git diff --exit-code --stat -- src/icon/generated",
        "dev": "vite build --watch",
        "pack:local": "pnpm build && pnpm pack",
        "test": "vitest run",
        "test:packed": "node scripts/packed-consumer-test.mjs"
    },
    "peerDependencies": {
        "react": ">=19",
        "react-dom": ">=19"
    },
    "devDependencies": {
        "@jig-ui/styles": "workspace:*",
        "@jig-ui/tsconfig": "workspace:*",
        "@phosphor-icons/core": "^2.1.1",
        "@storybook/react-vite": "^10.5.7",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.4",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vanilla-extract/css": "^1.20.0",
        "@vanilla-extract/recipes": "^0.5.7",
        "@vanilla-extract/sprinkles": "^1.6.5",
        "@vanilla-extract/vite-plugin": "^5.2.1",
        "jsdom": "^30.0.1",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "storybook": "^10.5.7",
        "typescript": "^6.0.2",
        "vite": "8.0.3",
        "vite-plugin-dts": "^4.5.4",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@base-ui/react": "~1.7.0"
    }
}
