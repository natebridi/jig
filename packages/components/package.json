{
    "name": "@jig-ui/react",
    "version": "1.0.0",
    "description": "Jig design system — React components",
    "license": "MIT",
    "author": "Nate Bridi",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/natebridi/jig.git",
        "directory": "packages/components"
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./tokens": {
            "types": "./dist/tokens.d.ts",
            "default": "./dist/tokens.js"
        },
        "./icons": {
            "types": "./dist/icons.d.ts",
            "default": "./dist/icons.js"
        },
        "./styles.css": "./dist/styles.css",
        "./reset.css": "./dist/reset.css",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "generate:icons": "node scripts/generate-icons.mjs",
        "verify:types": "node scripts/verify-types.mjs",
        "dev": "vite build --watch",
        "pack:local": "pnpm build && pnpm pack"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "devDependencies": {
        "@jig-ui/styles": "workspace:*",
        "@jig-ui/tokens": "workspace:*",
        "@jig-ui/tsconfig": "workspace:*",
        "@phosphor-icons/core": "^2.1.1",
        "@storybook/react-vite": "^10.5.7",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vanilla-extract/css": "^1.20.0",
        "@vanilla-extract/recipes": "^0.5.7",
        "@vanilla-extract/sprinkles": "^1.6.5",
        "@vanilla-extract/vite-plugin": "^5.2.1",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "storybook": "^10.5.7",
        "typescript": "^6.0.2",
        "vite": "8.0.3",
        "vite-plugin-dts": "^4.5.4"
    }
}
