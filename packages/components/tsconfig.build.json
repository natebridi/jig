{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "declaration": true,
        "emitDeclarationOnly": true,
        "noEmit": false
    },
    "include": ["src"],
    // Stories and tests live beside their components but are not part of the
    // published package — the lib entry can't reach them and `files` is dist
    // only.
    "exclude": ["src/**/*.stories.tsx", "src/**/*.test.ts", "src/**/*.test.tsx", "src/vitest-env.d.ts"]
}
