{
    "description": "Internal: builds token CSS variables, the reset, and base styles",
    "name": "@jig-ui/styles",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        "./theme": "./dist/theme.css.ts",
        "./vars.css": "./dist/tokens.css",
        "./reset.css": "./dist/reset.css",
        "./base.css": "./dist/styles.css",
        "./tokens": {
            "types": "./dist/vars.d.ts",
            "default": "./dist/vars.js"
        }
    },
    "scripts": {
        "build": "tz build --config src/terrazzo.config.ts && vite build && copyfiles -u 1 src/styles.css dist/",
        "dev": "tz build --watch --config src/terrazzo.config.ts",
        "terrazzo": "tz build --config src/terrazzo.config.ts"
    },
    "sideEffects": [
        "**/*.css",
        "**/*.css.ts"
    ],
    "dependencies": {
        "@jig-ui/tokens": "workspace:*",
        "@vanilla-extract/css": "^1.20.0"
    },
    "devDependencies": {
        "@jig-ui/tsconfig": "workspace:*",
        "@terrazzo/cli": "^2.0.0",
        "@terrazzo/plugin-css": "^2.0.0",
        "@terrazzo/plugin-css-in-js": "^2.0.0",
        "@terrazzo/plugin-vanilla-extract": "^2.0.0",
        "@types/node": "25.5.0",
        "@vanilla-extract/vite-plugin": "^5.2.1",
        "copyfiles": "^2.4.1",
        "vite": "8.0.3"
    }
}
