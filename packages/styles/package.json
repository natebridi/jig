{
    "description": "Exports Vanilla Extract theme and contract",
    "name": "@jig-ui/styles",
    "type": "module",
    "exports": {
        "./theme": "./dist/theme.css.ts",
        "./vars.css": "./dist/tokens.css",
        "./reset": "./dist/reset.ts",
        "./base.css": "./dist/styles.css",
        "./tokens": {
            "types": "./dist/vars.d.ts",
            "default": "./dist/vars.js"
        },
        "./breakpoints": "./dist/breakpoints.ts"
    },
    "scripts": {
        "build": "tz build --config src/terrazzo.config.ts && copyfiles -u 1 src/reset*.ts dist/ && copyfiles -u 1 src/breakpoints.ts dist/ && copyfiles -u 1 src/styles.css dist/",
        "terrazzo": "tz build --config src/terrazzo.config.ts"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "dependencies": {
        "@jig-ui/tokens": "workspace:*",
        "@vanilla-extract/css": "^1.20.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4"
    },
    "devDependencies": {
        "@jig-ui/tsconfig": "workspace:*",
        "@terrazzo/cli": "^2.0.0",
        "@terrazzo/plugin-css": "^2.0.0",
        "@terrazzo/plugin-css-in-js": "^2.0.0",
        "@terrazzo/plugin-vanilla-extract": "^2.0.0",
        "@types/node": "25.5.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vanilla-extract/vite-plugin": "^5.2.1",
        "copyfiles": "^2.4.1",
        "node": "25.8.2",
        "vite": "8.0.3"
    }
}