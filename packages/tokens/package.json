{
    "description": "Generates design tokens in DTCG format",
    "name": "@jig-ui/tokens",
    "type": "module",
    "version": "0.0.0",
    "private": true,
    "exports": {
        "./color": "./dist/color.dtcg.json",
        "./resolver": "./dist/tokens.dtcg.json"
    },
    "scripts": {
        "build": "tsx ./build.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "dev": "tsx watch --clear-screen=false ./build.ts",
        "test": "vitest run"
    },
    "devDependencies": {
        "@jig-ui/tsconfig": "workspace:*",
        "@types/node": "^25.5.0",
        "tsx": "^4.21.0",
        "vitest": "^4.1.10"
    }
}
