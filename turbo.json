{
    "tasks": {
        "build": {
            "dependsOn": ["^build", "typecheck"],
            "inputs": ["$TURBO_DEFAULT$", "!README.md"],
            "outputs": ["dist/**"]
        },
        "typecheck": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "!README.md"],
            "outputs": []
        },
        "test": {
            // Depends on this package's own build too: the token contract
            // tests read the generated stylesheet out of dist.
            "dependsOn": ["^build", "build"],
            "inputs": ["$TURBO_DEFAULT$", "!README.md"],
            "outputs": []
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "storybook": {
            "dependsOn": ["^build"],
            "cache": false,
            "persistent": true
        },
        "build-storybook": {
            "dependsOn": ["^build"],
            "outputs": ["storybook-static/**"]
        }
        // There is deliberately no `lint` task. One existed, and passed on
        // every run — because no package defined a lint script, so Turbo had
        // nothing to run. A green check that cannot fail is worse than no
        // check. Reinstate this alongside an actual linter.
    }
}